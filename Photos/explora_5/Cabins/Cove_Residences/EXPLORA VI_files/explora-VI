    <script>
        window.dataLayer = window.dataLayer || [];
        const templates = {
          "country_selector": "/conf/explora-b2c/settings/wcm/templates/country-language-selector",
          "homepage": "/conf/explora-b2c/settings/wcm/templates/home-page",
          "homepage_new": "/conf/explora-b2c/settings/wcm/templates/home-page-new",
          "region": "/conf/explora-b2c/settings/wcm/templates/region",
          "post_listing": "/conf/explora-b2c/settings/wcm/templates/article-post-listing",
          "article_post": "/conf/explora-b2c/settings/wcm/templates/article-post",
          "content_solid_header": "/conf/explora-b2c/settings/wcm/templates/page-content-header-solid",
          "error": "/conf/explora-b2b/settings/wcm/templates/static-page-with-message",
          "faq": "/conf/explora-b2c/settings/wcm/templates/b2c-explora---faq-subpage",
          "faq_landing": "/conf/explora-b2c/settings/wcm/templates/b2c-explora---faq-landing",
          "journey_list": "/conf/explora-b2c/settings/wcm/templates/journeys-list",
          "journey_page": "/conf/explora-b2c/settings/wcm/templates/journey-details",
          "campaign_landing": "/conf/explora-b2c/settings/wcm/templates/b2c-explora---campaign-landing",
          "checkin_page": "/conf/explora-b2c/settings/wcm/templates/web-checkin",
          "my_explora": "/conf/explora-b2c/settings/wcm/templates/my-explora",
          "generic_journey_details": "/conf/explora-b2c/settings/wcm/templates/generic-journey-details",
          "journey_detail_page_hub_template": "/conf/explora-b2c/settings/wcm/templates/journey-detail-page-hub-template"
        }
        const pageLanguage = "en";
        const pagePath = "/content/explora/b2c/int/en/ships/explora-VI";
        const pagePathAfterLanguageSuffix = pagePath.substring(pagePath.indexOf("/" + pageLanguage.toLowerCase()) + 3);
        const pagePathAfterCountrySuffix = pagePath.substring(pagePath.indexOf("/" + pageLanguage.toLowerCase()));

        var pageUrlParts = pagePathAfterLanguageSuffix.split("/");
        var pageUrlParts1 = pagePathAfterCountrySuffix.split("/");
        var pagePathAfterLanguage = pagePathAfterLanguageSuffix;

        if (pageUrlParts1[1] == pageUrlParts1[2]) {
          pageUrlParts.shift();
          pagePathAfterLanguage = pagePathAfterLanguageSuffix.substring(3)
        }

        let currentPageTemplate = "/conf/explora-b2c/settings/wcm/templates/page-content";
        let pageType = "content";
        let currentHref = window.location.href;
        const host = window.location.host;
        const env = host.includes('preprod') || host.includes('uat') ? 'staging' : 'prod';

        let pageViewProps = {
          'event': 'page_view', // mandatory key
          'p_business_type': 'B2C',
          'p_environment': env,
          'p_language': "en",
          'p_country': "INT",
          'p_location': currentHref,
          'p_path': pageUrlParts[1] == null ? '/' : pagePathAfterLanguage,
          'p_name': currentPageTemplate == templates.faq ? "FAQ - " + "EXPLORA VI" : "EXPLORA VI",
          'p_category': pageUrlParts[1] != null ? pageUrlParts[1] : "undefined",
          'p_sub_category': pageUrlParts[2] != null ? pageUrlParts[2] : "undefined",
          'p_sub_sub_category': pageUrlParts[3] != null ? pageUrlParts[3] : "undefined",
        }

        let purchaseEvent = {};

        if (pageUrlParts[2] != null && currentPageTemplate != templates.country_selector) pageViewProps.p_sub_category = pageUrlParts[2];
        if (pageUrlParts[3] != null && currentPageTemplate != templates.country_selector) pageViewProps.p_sub_sub_category = pageUrlParts[3];

        let faqSubCategory = currentHref.substring(currentHref.indexOf('#') + 1);
        if (currentPageTemplate == templates.faq && !faqSubCategory.includes("/")) pageViewProps.p_sub_category = faqSubCategory;

        switch (currentPageTemplate) {
          case templates.country_selector:
            pageType = "country_choice";
            break;

          case templates.homepage:
          case templates.homepage_new:
            pageType = "homepage";
            pageViewProps.p_category = "homepage";
            break;

          case templates.region:
            pageViewProps.p_journey_destination = "";
            pageViewProps.p_category = "regional";
            pageViewProps.p_sub_sub_category = "regional product list";
            break;

          case templates.post_listing:
          case templates.article_post:
          case templates.faq:
          case templates.faq_landing:
            pageType = "information";
            break;

          case templates.content_solid_header:
            pageType = "booking";
            break;

          case templates.journey_list:
            pageType = "journey_list";
            pageViewProps.p_name = pageUrlParts[2] + ' - journey_list';
            pageViewProps.p_journey_destination = "";
            break;

          case templates.journey_page:
            pageType = "journey_page";
            pageViewProps.p_name = pageViewProps.p_name + ' - journey_page';
            if (pageUrlParts[2] != null) pageViewProps.p_sub_category = pageUrlParts[2];
            if (pageUrlParts[4] != null) pageViewProps.p_sub_sub_category = pageUrlParts[4];
            pageViewProps.p_journey_destination = "";
            break;

          case templates.campaign_landing:
            pageType = "campaign_landing_page";
            break;

          case templates.checkin_page:
            pageViewProps.p_name = pageViewProps.p_category + "-" + pageViewProps.p_sub_category;
            if (pageUrlParts[2] == "post-login-page" || pageUrlParts[2] == "guests-list") {
              pageType = "checkin";
            } else if (pageUrlParts[2] == "thank-you-page") {
              pageType = "checkin_complete";
            } else {
              pageViewProps.event = null;
            }
            break;

          case templates.my_explora:
            pageType = "my_explora";
            pageViewProps.p_category = "my_journeys";
            if (pageUrlParts[2] != null && pageUrlParts[2].includes("my-account")){
              pageViewProps.p_category = "my_account";
            } else if (pageUrlParts[2] != null && pageUrlParts[2].includes("support")) {
              pageViewProps.p_category = "support_contact";
            } else if (pageUrlParts.length >= 5 && pageUrlParts[5] != null && pageUrlParts[5].includes("my-reservations")) {
              pageType = "addon_cart_view";
              pageViewProps.p_category = "addon";
              pageViewProps.p_name = "journey_details – personalize_your_journey – my_reservations";
              const urlObj = new URL(window.location.href);
              const params = new URLSearchParams(urlObj.search);
              const reservationId = params.get('reservationId');
              const journeyCode = params.get('journeyCode');
              pageViewProps.ResID = reservationId || "";
              pageViewProps.journey_code = journeyCode || "";
              pageViewProps.journey_addon_location = "";
            } else if (pageUrlParts.length >= 5 && pageUrlParts[5] != null && pageUrlParts[5].includes("reservations-confirmation")) {
              pageViewProps.p_category = "payment_confirmation";
              const urlObj = new URL(window.location.href);
              const params = new URLSearchParams(urlObj.search);
              const reservationId = params.get('reservationId');
              const journeyCode = params.get('journeyCode');
              //start tagging plan :: purchase
              try {
                // purchase event
                const currency = sessionStorage.getItem("SS_shipping_info_currency");
                const amount = sessionStorage.getItem("SS_shipping_info_amount");
                let items = JSON.parse(sessionStorage.getItem("SS_shipping_info_items"));
                let payments = JSON.parse(sessionStorage.getItem("SS_shipping_info_payments"));
                const merchantReference = sessionStorage.getItem("adyen_merchant_reference");
                const journeyFare = JSON.parse(sessionStorage.getItem("SS_shipping_info_journeyFare"));
                const agencyType = sessionStorage.getItem("SS_shipping_info_agency_type") || "";
                const bookingStatus = sessionStorage.getItem("SS_shipping_info_booking_status") || "";

                let journeyAmount = 0;
                if(!items || items.length === 0){
                  items = [];
                }
                if(!payments || payments.length === 0){
                  payments = [];
                }
                
                // Update payments to mark selected ones as paid
                const isDestexDirectPayment = items.length > 0 && items.filter(item => item.item_category2 == "destination").length > 0;
                const duePaymentTypes = JSON.parse(sessionStorage.getItem('SS_payment_info_duePaymentTypes')) || [];
                const selectedPaymentTypes = duePaymentTypes.filter(payment => payment.selected === true).map(payment => payment.type);
                if (isDestexDirectPayment) {
                  selectedPaymentTypes.push("destex");
                }
                
                payments.forEach(payment => {
                  if (selectedPaymentTypes.includes(payment.type)) {
                    payment.paid = "yes";
                  }
                });

                const hasUnpaidFinalOrDeposit = items.some(
                  item =>
                    item.item_type.toLowerCase().includes("deposit") ||
                    item.item_type.toLowerCase().includes("final")
                );

                if (hasUnpaidFinalOrDeposit) {
                  journeyAmount = Object.values(journeyFare).reduce(
                    (acc, fare) => acc + fare,
                    0
                  );
                }
                
                // Validate required fields before creating purchase event
                const validationErrors = [];
                if (!merchantReference || merchantReference === "" || merchantReference === "null" || merchantReference === "undefined") {
                  validationErrors.push("merchantReference is missing or invalid");
                }
                if (!currency || currency === "" || currency === "null" || currency === "undefined") {
                  validationErrors.push("currency is missing or invalid");
                }
                if (!amount || amount === "" || amount === "null" || amount === "undefined" || amount === "0") {
                  validationErrors.push("amount is missing or invalid");
                }
                
                if (validationErrors.length > 0) {
                  console.error("My Explora - Purchase - validation failed:", validationErrors.join(", "));
                } else {
                  // Ensure all items have price as number or 0
                  const normalizedItems = items.map(item => ({
                    ...item,
                    "price": typeof item.price === 'number' && !isNaN(item.price) ? item.price : (Number(item.price) || 0)
                  }));
                  
                  purchaseEvent = {
                    "event": "purchase",
                    "ecommerce": {
                      "transaction_id": merchantReference,
                      "currency": currency || "",
                      "value": typeof amount === 'number' && !isNaN(amount) ? amount : (Number(amount) || 0),
                      "tax": 0,
                      "items": normalizedItems
                    },
                    "booking_status": bookingStatus || "",
                    "payment_method": "Credit Card",
                    "ResID": reservationId,
                    "journey_code": journeyCode,
                    "journey_amount": journeyAmount,
                    "journey_amount_detail": journeyFare,
                    "a_agency_type": agencyType,
                    "payments": payments
                  };
                }
              } catch (error) {
                console.error("My Explora - Purchase - analytics error", error);
              }
              //end tagging plan
            } else {
              pageViewProps.p_sub_category = "home";
            }
            break;

          case templates.generic_journey_details:
            pageViewProps.p_category = "pdp";
            const destination = window.location.href.match(/\/destinations-globe\/([^\/]+)/);
            pageViewProps.p_sub_category = destination ? destination[1] : "";
            pageViewProps.p_sub_sub_category = "journey product details";
            break;
          
          case templates.journey_detail_page_hub_template:
            pageViewProps.p_category = "pdp";
            const destinationArea = window.location.href.match(/\/destinations-globe\/([^\/]+)/);
            pageViewProps.p_sub_category = destinationArea ? destinationArea[1] : "";
            pageViewProps.p_sub_sub_category = "journey product details";
            break;

          case templates.error:
            pageType = "error";
            break;

          default:
            pageType = "content";
            if (pagePathAfterCountrySuffix.includes("info") || "default" == "information") {
              pageType = "information";
            }
            if ("default" == "contact") {
              pageType = "contact";
            }
            break;
        }
        pageViewProps.p_type = pageType;

        function getCookie(name) {
          let value = ";" + document.cookie;
          let parts = value.split(";" + name + "=");
          if (parts.length === 2) return parts.pop().split(';').shift();
        }

        const consent = setInterval(function () {
          const result = getCookie("euconsent-v2");
          const didomiLayer =
            window.dataLayer.some(item => item.event === "didomi-ready"
              || (item.event && item.event.includes && item.event.includes("didomi-ready"))
            );

          if (result != undefined && didomiLayer) {
            if(pageViewProps.event != null) {
              window.dataLayer.push(pageViewProps);
            }
            clearInterval(consent);
          }
        }, 50)
        if (pageUrlParts.length >= 5 && pageUrlParts[5] != null && pageUrlParts[5].includes("reservations-confirmation")) {
          const purchaseEventInterval = setInterval(function () {
            const dataLayer = window.dataLayer;
            if(dataLayer.length > 0 && (dataLayer.some(item => item.event === "page_view") && dataLayer.some(item => item.event === "user_data"))) {
              // Only push purchase event if it's not empty (validation passed)
              if (purchaseEvent && Object.keys(purchaseEvent).length > 0) {
                dataLayer.push(purchaseEvent);
              }
              clearInterval(purchaseEventInterval);
            }
          }, 100);
        }
    </script>


