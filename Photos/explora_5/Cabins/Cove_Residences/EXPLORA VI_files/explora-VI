    (function () {
        'use strict';
        window.isRecaptchaIncluded = false;
        window.loadRecaptchaOnce = function (recaptchaSrcPath, elSelector) {
            if (typeof grecaptcha !== 'undefined' || window.isRecaptchaIncluded) {
                return Promise.resolve();
            }

            const loadScript = () => {
                window.isRecaptchaIncluded = true;
                return new Promise((resolve, reject) => {
                    const script = document.createElement('script');
                    script.src = recaptchaSrcPath;
                    script.async = true;
                    script.defer = true;
                    script.onload = () => resolve();
                    script.onerror = reject;
                    document.head.appendChild(script);
                });
            };

            if (!elSelector) {
                return loadScript();
            }

            const elTarget = document.querySelector(elSelector);

            if (!elTarget || typeof IntersectionObserver === 'undefined') {
                return loadScript();
            }

            return new Promise((resolve, reject) => {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        observer.disconnect();
                        if (typeof grecaptcha !== 'undefined' || window.isRecaptchaIncluded) {
                            resolve();
                            return;
                        }
                        window.isRecaptchaIncluded = true;
                        const script = document.createElement('script');
                        script.src = recaptchaSrcPath;
                        script.async = true;
                        script.defer = true;
                        script.onload = () => resolve();
                        script.onerror = reject;
                        document.head.appendChild(script);
                    });
                }, { rootMargin: '400px', threshold: 0.2 });
                observer.observe(elTarget);
            });
        };
    })();
