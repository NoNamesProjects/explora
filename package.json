{
  "name": "explora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Partner-facing site for Explora Journeys — Vite + React + TS, Vercel /api/* + cPanel dual deploy, Neon Postgres, ingested daily from the Explora flatfile API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsx scripts/build-server.ts",
    "build:deploy": "npm run build && npm run build:server",
    "preview": "vite preview",
    "start": "node server.js",
    "server:dev": "npm run build:deploy && node server.js",
    "smoke": "node scripts/smoke-server.mjs",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "probe:auth": "tsx scripts/probe.ts -- --auth-only",
    "parse:check": "tsx scripts/parse-check.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed:smoke": "tsx scripts/seed-smoke.ts",
    "admin:user": "tsx scripts/admin-user.ts",
    "ingest": "tsx scripts/ingest-once.ts",
    "seed:dev": "tsx scripts/dev-seed.ts",
    "ingest:dry": "INGEST_DRY_RUN=1 tsx scripts/ingest-once.ts",
    "fetch:port-images": "tsx scripts/fetch-port-images.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "express": "^5.0.1",
    "framer-motion": "^11.11.17",
    "i18next": "^24.0.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^6.27.0",
    "resend": "^4.0.0",
    "swiper": "^12.1.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.22.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
