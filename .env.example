# Copy to .env.local for dev or set via Vercel/cPanel env panel for production.
# Never commit a real .env to git.

# ── Explora Journeys flatfile API ─────────────────────────────────────────
# Preprod and Production are SEPARATE OKTA tenants — accept BOTH welcome
# emails and activate BOTH accounts before any sync runs.
# Set EXPLORA_ENV=preprod or prod to pick the matching URLs.
EXPLORA_ENV=preprod
EXPLORA_USERNAME=<explora-partner-username>
EXPLORA_PASSWORD=<explora-partner-password>
# Override the resolved URLs only if Explora rotates endpoints:
# EXPLORA_AUTH_URL=https://idpb2b.explorajourneys.com/api/v1/authn
# EXPLORA_FILES_URL=https://techpartner.explorajourneys.com/ota/file/operations/system/

# ── Database (Postgres) ───────────────────────────────────────────────────
# Prod: a hosted Postgres (Neon recommended — the dual-driver auto-detects
#   *.neon.tech and uses the HTTP driver; any other host uses the TCP driver).
# Dev: a local Postgres works too, e.g. postgresql://you@localhost:5432/explora
DATABASE_URL=postgresql://user:pass@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/explora?sslmode=require

# ── Email (Resend) ────────────────────────────────────────────────────────
# ⚠️ REQUIRED in production: without it newsletter confirmations, booking
# notifications and broadcasts are silently skipped (subscribers stay pending).
RESEND_API_KEY=
RESEND_FROM=Explora Partner <noreply@example.com>
# Public origin of the deployed site, e.g. https://partner.example.com.
# Set in production: it is the authoritative source for emailed
# confirm/unsubscribe links AND forces the Secure flag on admin cookies
# (otherwise both are inferred from request headers).
PUBLIC_BASE_URL=
# Where the ingest watchdog's alert emails go (falls back to
# BOOKING_NOTIFY_EMAIL, then RESEND_FROM):
WATCHDOG_NOTIFY_EMAIL=

# ── Image CDN (Cloudinary) ────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_BASE=https://res.cloudinary.com

# ── Destination photos (Pexels) ───────────────────────────────────────────
# Free key from https://www.pexels.com/api/ — used by `npm run fetch:port-images`
# to download one landscape photo per port into public/photos/ports/.
PEXELS_API_KEY=

# ── Booking deposit (PayPal) ───────────────────────────────────────────────
# Free sandbox app: https://developer.paypal.com → Apps & Credentials → REST app.
# Leave blank to run the wizard as a no-charge request (team-confirms) flow.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Same sandbox client id, exposed to the browser SDK:
VITE_PAYPAL_CLIENT_ID=
# Reservation deposit as a % of the indicative fare total:
DEPOSIT_PERCENT=20
# Where new booking requests are emailed (falls back to RESEND_FROM):
BOOKING_NOTIFY_EMAIL=cruises2greece@outlook.com

# ── Misc ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORT=3000
# Set to 1 to short-circuit the cron handler (no auth, no fetch, no parse).
INGEST_DRY_RUN=0
# Bearer for /api/cron/ingest-flatfiles when triggered manually.
CRON_SECRET=
